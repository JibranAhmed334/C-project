@model project.ViewModel.RegisterViewModel


<div class="container">
    <div class="form-box">
        <h3 class="text-center mb-4" style="color:var(--brand)"><i class="bi bi-person-plus"></i> Create Account</h3>

        <form asp-action="Register"  onsubmit="registerUser(event)" method="Post">



            <div class="mb-3">
                <label  asp-for="Username"  class="form-label">Full Name</label>
                <input asp-for="Username"  required class="form-control">
                <span asp-validation-for="Username" class=" text-danger" ></span>
                </div>


                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" required class="form-control">
                        <span asp-validation-for="Email" class=" text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Phone" class="form-label">Phone</label>
                        <input asp-for="Phone" required class="form-control">
                            <span asp-validation-for="Phone" class=" text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Password</label>
                            <input asp-for="Password" required class="form-control">
                                <span asp-validation-for="Password" class=" text-danger"></span>
                            </div>
            <button class="btn btn-accent w-100">Register</button>
            <p class="text-center mt-3 small">Already have an account? <a href="login.html">Login</a></p>
        </form>
    </div>
</div>